{
  "name": "debun-eval",
  "version": "0.1.0",
  "private": true,
  "description": "Re-measure DEBUN library-detection score against the pnpm-sep-25 annotated bundle dataset. Vendors the DEBUN POG fingerprint engine under src/engine and a faithful port of the score_u library scorer.",
  "scripts": {
    "collect-corpus": "ts-node --transpile-only src/collect-corpus.ts",
    "build-db": "ts-node --transpile-only src/build-db.ts",
    "evaluate": "ts-node --transpile-only src/eval.ts",
    "dataset-csv": "ts-node --transpile-only src/dataset-to-csv.ts"
  },
  "dependencies": {
    "escodegen": "2.1.0",
    "meriyah": "6.0.6",
    "rapidhash-js": "1.0.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.4.0"
  }
}
